table Dim_Arrondissement

	column arrondissement
		dataType: string
		summarizeBy: none
		dataCategory: Place
		sourceColumn: arrondissement

	column hexagones
		dataType: int64
		summarizeBy: sum
		sourceColumn: hexagones

	column score_moyen_100
		dataType: double
		summarizeBy: sum
		sourceColumn: score_moyen_100

	column zones_recommandees
		dataType: int64
		summarizeBy: sum
		sourceColumn: zones_recommandees

	column population
		dataType: int64
		summarizeBy: sum
		sourceColumn: population

	column agences_concurrentes
		dataType: int64
		summarizeBy: sum
		sourceColumn: agences_concurrentes

	column agences_client
		dataType: int64
		summarizeBy: sum
		sourceColumn: agences_client

	column superficie_km2
		dataType: double
		summarizeBy: sum
		sourceColumn: superficie_km2

	column agences_total
		dataType: int64
		summarizeBy: sum
		sourceColumn: agences_total

	column hab_par_agence
		dataType: int64
		summarizeBy: sum
		sourceColumn: hab_par_agence

	column agences_pour_10k_hab
		dataType: double
		summarizeBy: sum
		sourceColumn: agences_pour_10k_hab

	column part_client_pct
		dataType: double
		summarizeBy: sum
		sourceColumn: part_client_pct

	partition Dim_Arrondissement = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DossierGold & "dim_arrondissements.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    EnTetes = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Types = Table.TransformColumnTypes(EnTetes, {{"arrondissement", type text}, {"hexagones", Int64.Type}, {"score_moyen_100", type number}, {"zones_recommandees", Int64.Type}, {"population", Int64.Type}, {"agences_concurrentes", Int64.Type}, {"agences_client", Int64.Type}, {"superficie_km2", type number}, {"agences_total", Int64.Type}, {"hab_par_agence", Int64.Type}, {"agences_pour_10k_hab", type number}, {"part_client_pct", type number}}, "en-US")
				in
				    Types
