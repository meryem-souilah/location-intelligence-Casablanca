table Qualite_Regles

	column id
		dataType: string
		summarizeBy: none
		sourceColumn: id

	column dimension
		dataType: string
		summarizeBy: none
		sourceColumn: dimension

	column regle
		dataType: string
		summarizeBy: none
		sourceColumn: regle

	column valeur
		dataType: string
		summarizeBy: none
		sourceColumn: valeur

	column seuil
		dataType: string
		summarizeBy: none
		sourceColumn: seuil

	column commentaire
		dataType: string
		summarizeBy: none
		sourceColumn: commentaire

	column statut
		dataType: string
		summarizeBy: none
		sourceColumn: statut

	partition Qualite_Regles = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DossierGold & "qualite_regles.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    EnTetes = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Types = Table.TransformColumnTypes(EnTetes, {{"id", type text}, {"dimension", type text}, {"regle", type text}, {"valeur", type text}, {"seuil", type text}, {"commentaire", type text}, {"statut", type text}}, "en-US")
				in
				    Types
