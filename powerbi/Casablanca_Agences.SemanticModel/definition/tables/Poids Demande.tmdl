table 'Poids Demande'

	column 'Poids Demande'
		dataType: int64
		formatString: 0
		summarizeBy: none
		isNameInferred
		sourceColumn: [Value]

	measure 'Valeur Poids Demande' = SELECTEDVALUE ( 'Poids Demande'[Poids Demande], 35 )
		formatString: 0

	partition 'Poids Demande' = calculated
		mode: import
		source = GENERATESERIES ( 0, 100, 5 )
